#!/bin/sh
# /app/bin/claude-sandboxed, in the ai variant: runs Claude Code with
# --dangerously-skip-permissions, so that it asks nothing, in a sandbox of
# its own inside the app's. Claude Code's own sandbox cannot run in a
# Flatpak, so this box is the boundary for running it without questions.
#
#   claude-sandboxed [ARG...]           Claude Code, with ARGs
#   claude-sandboxed --shell [ARG...]   your shell in the same box, to look
#                                       around or build what it changed
#
# The box is made with flatpak-spawn --sandbox, through flatpak's portal,
# which needs no permission.
#   - It gets the git repository it is started in, the network, the app's
#     /dev/kvm (see below) and the tools in /app.
#   - It gets no other files (not the app's Docker socket), no D-Bus, no
#     host commands, no ssh-agent, no Wayland display and no other device.
#   - The network is the app's, which is the host's. Services on localhost
#     and the host's Xwayland (its abstract socket) are reachable from in
#     here.
#
# The repository's .git, .vscode, .devcontainer, .devcontainer.json and
# .claude are read-only. They hold what runs later outside this box: hooks
# and core.fsmonitor for git, tasks for VS Code, initializeCommand for Dev
# Containers, and hooks for the claude outside. Where one of those
# directories is missing, an empty one is made, so that none can be added
# either. git ignores empty directories.
#
# Some files cannot be held that way:
#   - A missing .devcontainer.json, because an empty file is not valid JSON.
#   - A new .cargo/config.toml, which rust-analyzer runs as it runs build.rs.
#   - mise's config at the top level (mise.toml, mise.local.toml and the
#     rest). It runs outside too, at the next cd in a terminal, but only
#     once you trust it as it is (MISE_PARANOID, mise-config.toml).
# Claude cannot commit from in here, as .git is read-only. It can still
# change the Justfile, build scripts and CI. So read git status and its
# diff, then build and commit yourself.
#
# In a worktree, .git is a file that names the repository elsewhere. That
# repository is shown read-only as well, or git would not work in here.
#
# Claude's login, settings and caches are in a directory of its own. That is
# never the CLAUDE_CONFIG_DIR of the claude outside, whose hooks would run
# outside.
set -eu

# --- The repository ---
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "claude-sandboxed: not in a git repository. It runs in one, so that you review its changes with git (git init makes one)." >&2
    exit 1
}
dir=$XDG_DATA_HOME/claude-sandboxed
outer=${CLAUDE_CONFIG_DIR:-$XDG_CONFIG_HOME/claude}
# Paths are compared as real paths, because git gives the top level as one.
# (/home is a link to var/home on Fedora's atomic and bootc systems.)
case $root in
/ | "$(realpath -- "$HOME")") echo "claude-sandboxed: $root holds more than a project" >&2 && exit 1 ;;
esac
case $(realpath -m -- "$outer")/ in
"$(realpath -m -- "$dir")"/* | "$root"/*) echo "claude-sandboxed: CLAUDE_CONFIG_DIR ($outer) would be inside its box" >&2 && exit 1 ;;
esac
mkdir -p "$dir" "$root/.vscode" "$root/.devcontainer" "$root/.claude"
# The repository itself, when .git is a file that names it:
#   - in a worktree, its own gitdir, and the main checkout's .git that it
#     shares
#   - in a submodule, the superproject's .git/modules/<name>
# Each is left out where $root/.git already covers it, or the shared one
# does.
gitdir=$(realpath -- "$(git rev-parse --path-format=absolute --git-dir)")
common=$(realpath -- "$(git rev-parse --path-format=absolute --git-common-dir)")
case $gitdir/ in "$root"/* | "$common"/*) gitdir= ;; esac
case $common/ in "$root"/*) common= ;; esac

# --- KVM ---
# The app's /dev/kvm (the Containerfile's labels), for VMs in the box too.
# The portal passes it on with sandbox flag 128 (share-kvm), and only where
# the app has it itself.
# That flag came with the portal's version 8 (flatpak 1.17.1). An older
# portal refuses the flag, and the whole box with it, so the flag is asked
# for only from version 8 on.
# The runtime's flatpak-spawn (Fedora's 1.0.6) knows the flag by number
# only. Later versions know it by name only (share-kvm). A runtime that
# ships one of those needs the name here, and test.sh's test of the box
# fails until then.
version=$(gdbus call --session --dest org.freedesktop.portal.Flatpak \
    --object-path /org/freedesktop/portal/Flatpak \
    --method org.freedesktop.DBus.Properties.Get org.freedesktop.portal.Flatpak version 2>/dev/null) || version=
version=${version#*uint32 } version=${version%%>*}
kvm=
case $version in '' | *[!0-9]*) ;; *) if [ "$version" -ge 8 ]; then kvm=1; fi ;; esac

# --- Run it in the box ---
if [ "${1:-}" = --shell ]; then
    shift
    set -- "${SHELL:-/bin/sh}" "$@"
else
    set -- /app/bin/claude --dangerously-skip-permissions "$@"
fi
# The box starts from the app's environment, not this one, so what it needs
# from here is passed by name. Its home is an empty tmpfs, so the XDG dirs,
# Go's and Cargo's are kept in $dir.
exec flatpak-spawn --sandbox --watch-bus ${kvm:+"--sandbox-flag=128"} \
    --sandbox-expose-path="$root" \
    --sandbox-expose-path-ro="$root/.git" \
    --sandbox-expose-path-ro="$root/.vscode" \
    --sandbox-expose-path-ro="$root/.devcontainer" \
    --sandbox-expose-path-ro-try="$root/.devcontainer.json" \
    --sandbox-expose-path-ro="$root/.claude" \
    ${gitdir:+"--sandbox-expose-path-ro=$gitdir"} \
    ${common:+"--sandbox-expose-path-ro=$common"} \
    --sandbox-expose-path="$dir" \
    --env=CLAUDE_CONFIG_DIR="$dir/claude" \
    --env=XDG_CONFIG_HOME="$dir/config" --env=XDG_DATA_HOME="$dir/data" \
    --env=XDG_CACHE_HOME="$dir/cache" --env=XDG_STATE_HOME="$dir/state" \
    --env=GOPATH="$dir/go" --env=CARGO_HOME="$dir/cargo" \
    --env=TERM="${TERM:-dumb}" --env=COLORTERM="${COLORTERM:-}" \
    --directory="$(pwd -P)" "$@"
